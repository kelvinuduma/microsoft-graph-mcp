# Microsoft Graph API Credentials
# Get these by registering an app in Entra ID (Azure Portal) -> App Registrations

# Required for all flows:
MICROSOFT_CLIENT_ID=your_client_id_here

# Optional: Set to your Azure tenant ID (Directory ID). Defaults to "common" for multi-tenant / personal accounts.
MICROSOFT_TENANT_ID=common

# Optional: Provide Client Secret only if using Confidential Client flow (client credentials/daemon flow).
# If omitted, the server defaults to interactive Public Client (Device Code Flow) requiring user login.
# MICROSOFT_CLIENT_SECRET=your_client_secret_here

# Optional: On Linux headless/WSL environments without LibSecret / gnome-keyring,
# set to true to allow plaintext token storage under ~/.microsoft-graph-mcp/
# MSAL_USE_PLAINTEXT_CACHE=false

